# Vercel Ignore - Files to exclude from deployment

# Server directory (already wrapped in api/index.js)
server/node_modules
server/.env
server/.env.*

# Development files
node_modules
.git
.gitignore
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE files
.vscode
.idea
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Test files
*.test.js
*.test.ts
*.spec.js
*.spec.ts
__tests__
coverage

# Documentation (not needed in production)
docs/
*.md
!README.md

# ML model files (large files)
*.pkl
*.csv

# Build artifacts (will be regenerated)
dist
build
.next
out
