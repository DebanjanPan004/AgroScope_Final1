# Environment Variables for Vercel Deployment
# Copy these to your Vercel project settings

# MongoDB Atlas (Free Tier)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/agroscope

# DeepSeek AI API (for AI price negotiation)
# Get from: https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Tavily Search API (for agro news)
# Get from: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# JWT Authentication
JWT_SECRET=your_super_long_random_64_character_secret_string_here_use_crypto
JWT_EXPIRES_IN=7d

# Node Environment
NODE_ENV=production

# Optional: Google OAuth (if used)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Optional: OpenWeatherMap
OPENWEATHER_API_KEY=your_openweather_api_key_here
