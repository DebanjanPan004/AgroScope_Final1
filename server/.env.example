# AgroScope Backend Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file itself

# DeepSeek AI API (get from platform.deepseek.com)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Tavily Search API (get from tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/agroscope

# JWT Authentication
JWT_SECRET=your_super_long_random_secret_string_here_minimum_32_chars
JWT_EXPIRES_IN=7d

# Server configuration
PORT=5000
NODE_ENV=development

# Optional: Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Optional: OpenWeatherMap (if used)
OPENWEATHER_API_KEY=your_openweather_api_key_here
